# --------------------------------------------------------------------------
# Ingestion Service — environment template
#
# Copy to .env and fill in. Generate API_KEY with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# --------------------------------------------------------------------------

# Auth — shared bearer token with Open WebUI (EXTERNAL_INGESTION_API_KEY in the
# parent stack). Required; the compose file fails to start if unset. Must be
# at least 32 characters — the service refuses to start with a shorter key.
API_KEY=

# Server
HOST=0.0.0.0
PORT=8000
# Operator-triage switch (NOT a logging dial): true reflects str(exc) in ingest
# error responses for local debugging. Leave false in production — the raw text
# can carry hostnames, paths, and AWS request IDs. For verbose app logs use
# LOG_LEVEL_APP below.
DEBUG=false

# Per-request upload cap (bytes). Applies to multipart file parts and S3
# fetches (via head_object). Default 100 MB.
MAX_UPLOAD_BYTES=104857600

# --------------------------------------------------------------------------
# Logging / observability
# --------------------------------------------------------------------------

# Root log verbosity: DEBUG | INFO | WARNING | ERROR | CRITICAL. The per-
# document routing decision (EXTRACTION_ENGINE=auto: engine + signal) logs at
# INFO; the detailed detector metrics (textbox counts, ratios, image area) log
# at DEBUG.
LOG_LEVEL=INFO
# Per-namespace override for the service's own loggers ('app.*'), applied on
# top of LOG_LEVEL. Set to DEBUG to see verbose app logs (e.g. routing detector
# metrics) without the third-party DEBUG flood (httpx/boto3/haystack). Empty
# inherits LOG_LEVEL. DEBUG | INFO | WARNING | ERROR | CRITICAL.
LOG_LEVEL_APP=
# text = human-readable single line (default); json = one JSON object per line
# for Loki / a structured-log pipeline (extra fields like file_id become keys).
LOG_FORMAT=text
# Expose Prometheus metrics at GET /metrics (ingest outcomes, per-stage latency,
# routing decisions). Bearer-authenticated with API_KEY (like /api/v1/ingest) —
# the scrape job must send Authorization: Bearer <API_KEY>. false → 404.
METRICS_ENABLED=true
# Expose the read-only chunk-inspection endpoint
# (GET /api/v1/documents/{file_id}/chunks). Returns chunk *content*, so it's
# opt-in. Bearer-auth applies either way; false → the endpoint returns 404.
ENABLE_INSPECTION_API=false

# --------------------------------------------------------------------------
# Extraction
# --------------------------------------------------------------------------

# pypdf | docling | unstructured | kreuzberg | vision-llm | hybrid-diagram | auto
# kreuzberg runs as an external HTTP sidecar (a container in the parent stack).
# pypdf is in-process and PDF-only.
# docling / unstructured require optional deps not bundled by default.
# vision-llm renders pages and reconstructs structure (flowcharts, diagrams) via
#   a multimodal LLM (needs VISION_LLM_* + the Gotenberg sidecar, below).
# hybrid-diagram (docx): native text from the package XML (authoritative, verbatim
#   labels — nothing dropped, nothing OCR-guessed) + a vision-inferred Mermaid graph.
#   Wraps vision-llm, so it needs the same VISION_LLM_* + Gotenberg config.
# auto enables per-document routing: a docx with a vector flowchart (swim-lane,
#   textbox-heavy) OR a large body raster image (a flattened PNG diagram) goes to
#   EXTRACTION_ROUTER_DIAGRAM_ENGINE, everything else to EXTRACTION_ROUTER_DEFAULT.
#   See EXTRACTION_ROUTER_* below.
EXTRACTION_ENGINE=kreuzberg
KREUZBERG_URL=http://kreuzberg:8000
# Kreuzberg HTTP behaviour. Connect should fail fast so a stalled sidecar
# doesn't tie up a worker; read is long because extraction is CPU-bound.
KREUZBERG_CONNECT_TIMEOUT=5.0
KREUZBERG_READ_TIMEOUT=60.0
# Default true; explicit so verify=False can't be silently introduced.
KREUZBERG_TLS_VERIFY=true
# Min columns a detected table's markdown must have to be kept as a ## Tables
# section. The detector false-fires on multi-column prose, emitting 1-column
# line-dumps that duplicate the body. Default 2; set 1 to keep all tables.
KREUZBERG_MIN_TABLE_COLUMNS=2

# Content-based routing — only consulted when EXTRACTION_ENGINE=auto.
EXTRACTION_ROUTER_DEFAULT=kreuzberg
# hybrid-diagram keeps docx labels verbatim from the XML; vision-llm OCRs everything.
EXTRACTION_ROUTER_DIAGRAM_ENGINE=hybrid-diagram
# Vision-llm profile used for the auto-routed diagram (flowchart) case. Pinned
# separately from VISION_LLM_PROFILE so the engine's default can be changed for
# forced/explicit use without altering what auto-routing sends for flowcharts.
# NOTE: with the default diagram engine (hybrid-diagram) this is mostly moot —
# for a real docx the hybrid path pins its own "diagram-topology" profile and
# ignores this. It only applies to hybrid's empty-docx fallback, or when
# EXTRACTION_ROUTER_DIAGRAM_ENGINE=vision-llm (where it picks diagram/general/ocr).
EXTRACTION_ROUTER_DIAGRAM_PROFILE=diagram
# Absolute floor on drawing/text-box shapes before a docx can be considered
# diagram-heavy (stops a few callout boxes from triggering the costly engine).
EXTRACTION_ROUTER_MIN_TEXTBOXES=20
# Route to the diagram engine when drawing/text-box text outweighs body text by
# at least this ratio: ratio = drawing_text_units / (body_words + 1).
EXTRACTION_ROUTER_DRAWING_RATIO=2.0
# Raster-image signal (second trigger): a docx whose diagram is a flattened PNG
# (DrawingML <a:blip>, zero textboxes) — hybrid-diagram then uses the "figure"
# profile (native prose + a vision pass scoped to the image). Header/footer logos
# are excluded (only word/document.xml is read).
# Minimum embedded body images before the signal is considered.
EXTRACTION_ROUTER_MIN_BODY_IMAGES=1
# Display-area floor (EMU², from <wp:extent>) of the largest body image. 914400
# EMU = 1 inch, so 836_127_360_000 = 1 in². Default ~1.79 in²: a real diagram
# clears it; a logo/icon does not. Uses the max single image, not the sum.
EXTRACTION_ROUTER_MIN_IMAGE_EMU=1500000000000
# Optional guard against a lone large decorative photo: require
# max_image_emu / (body_words + 1) >= this. 0 = disabled (default) — a guessed
# threshold can't cleanly separate a real diagram from a hero-photo doc, and a
# decorative photo that slips through now degrades gracefully (figure vision pass
# returns nothing → native body alone). Calibrate against real samples before
# enabling.
EXTRACTION_ROUTER_MIN_IMAGE_WORD_RATIO=0.0

# --------------------------------------------------------------------------
# Vision LLM extraction (EXTRACTION_ENGINE=vision-llm, or the diagram engine
# for EXTRACTION_ENGINE=auto)
# --------------------------------------------------------------------------

# OpenAI-compatible multimodal chat endpoint (…/v1). Reconstructs page images
# into Markdown + a Mermaid flowchart. Leave base URL empty to disable.
VISION_LLM_API_BASE_URL=
VISION_LLM_API_KEY=
# Endpoint-specific model id — override to whatever your endpoint serves.
VISION_LLM_MODEL=gemma4-nvfp4
VISION_LLM_CONNECT_TIMEOUT=5.0
# Long read window — a quantized VLM over several page images is slow.
VISION_LLM_READ_TIMEOUT=180.0
# Render resolution and hard page cap (bounds image tokens, cost, and quality
# drift on long documents). Note: the hybrid-diagram "figure" path sends the
# embedded figure at its native resolution, so dpi does not affect it — only the
# full-page profiles (diagram/general/ocr) and the topology page render.
VISION_LLM_DPI=150
VISION_LLM_MAX_PAGES=20
# Max output tokens per call. Must leave room under the server's max-model-len
# (input images + prompt + output). Output over this fails the extraction
# (truncation) rather than silently cutting off. 16384 fits multi-page docs.
VISION_LLM_MAX_TOKENS=16384
VISION_LLM_TLS_VERIFY=true
# Document source language — the model keeps this language verbatim (no translation).
VISION_LLM_LANGUAGE_HINT=Danish
# Default prompt profile for forced/explicit vision-llm use (diagram | general | ocr):
# - diagram: swim-lane/flowchart -> lanes/phases/steps + a Mermaid flowchart block
# - general: faithful full-page transcription to clean Markdown
# - ocr: plain-text transcription of scanned pages
# NOTE: auto-routing's flowchart case uses EXTRACTION_ROUTER_DIAGRAM_PROFILE, not this.
VISION_LLM_PROFILE=general

# --------------------------------------------------------------------------
# Document rendering (Gotenberg sidecar) — office -> PDF for the vision engine
# --------------------------------------------------------------------------

# External Gotenberg container (headless LibreOffice behind an API). Keeps
# LibreOffice out of this image. Same operational model as tika / kreuzberg.
GOTENBERG_URL=http://gotenberg:3000
GOTENBERG_CONNECT_TIMEOUT=5.0
# LibreOffice conversion is the slow part, so read is generous.
GOTENBERG_READ_TIMEOUT=120.0
GOTENBERG_TLS_VERIFY=true

# --------------------------------------------------------------------------
# Chunking
# --------------------------------------------------------------------------

# token | markdown | word | sentence | passage
# - token (default): chunk size is measured in the embedding model's actual
#   HuggingFace tokens via a recursive char splitter. Keeps chunks under the
#   model's context window without hand-tuning word counts. Uses TOKENIZER_MODEL
#   if set, otherwise falls back to EMBEDDING_MODEL.
# - markdown: structure-aware mode. Splits on Markdown headings (#, ##, ###)
#   first, then token-packs each section when it exceeds CHUNK_SIZE. Each
#   chunk carries its heading hierarchy in meta.headers (e.g.
#   ["Privacy", "Foundational Principles"]). Most useful when the converter
#   emits Markdown (Docling natively; Kreuzberg after table-rendering is added).
#   Plain text content degrades gracefully to token-mode behaviour.
# - word / sentence / passage: delegates to Haystack's DocumentSplitter and
#   counts chunk size in those units (approximate vs. the model's tokenizer).
CHUNK_SPLIT_BY=token
CHUNK_SIZE=400
CHUNK_OVERLAP=80
# markdown mode only: sections smaller than this many tokens merge into
# adjacent ones (never past CHUNK_SIZE), so heading-dense docs don't produce
# tiny chunks that embed poorly and waste Qdrant points. 0 disables merging.
# Changing it changes chunk boundaries, so reindex for consistency.
CHUNK_MIN_SIZE=100
# Optional. Used in token and markdown modes; defaults to EMBEDDING_MODEL when empty.
TOKENIZER_MODEL=
# Optional. Pin the HuggingFace Hub revision (branch, tag, or commit SHA) used
# when downloading the tokenizer. Empty = whatever HEAD resolves to at fetch
# time. Pin a commit SHA in production to prevent an upstream model swap or HF
# account compromise from silently changing tokenizer behaviour.
# For the default EMBEDDING_MODEL (intfloat/multilingual-e5-large) the current
# HEAD SHA is 3d7cfbdacd47fdda877c5cd8a79fbcc4f2a574f3 (2026-04-02). Look up the
# current SHA for a different model via:
#   curl -s https://huggingface.co/api/models/<org>/<name> | jq -r .sha
TOKENIZER_REVISION=

# --------------------------------------------------------------------------
# Dense embedder (required)
# --------------------------------------------------------------------------

# openai-compat | fastembed | tei
EMBEDDING_PROVIDER=openai-compat
EMBEDDING_API_BASE_URL=https://embed.itkdev.dk/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=intfloat/multilingual-e5-large
EMBEDDING_DIM=1024
# Per the model card. e5: "passage: " on docs, "query: " on queries; bge-m3 takes none.
EMBEDDING_PREFIX_DOC="passage: "
EMBEDDING_PREFIX_QUERY="query: "
# Prepend the section-heading breadcrumb (meta.headers_breadcrumb, e.g.
# "Setup > Docker > Networking") to the text the embedders encode — the stored
# chunk content is untouched. Only has an effect with CHUNK_SPLIT_BY=markdown
# (the only mode that stamps the field). Flipping it changes vectors, so
# reindex for consistency.
EMBED_HEADERS_BREADCRUMB=true

# --------------------------------------------------------------------------
# Sparse embedder (optional)
# --------------------------------------------------------------------------

ENABLE_SPARSE_EMBEDDINGS=false
# fastembed | none
SPARSE_EMBEDDING_PROVIDER=fastembed
SPARSE_EMBEDDING_MODEL=Qdrant/bm42-all-minilm-l6-v2-attentions

# In-process embedder CPU budget. The fastembed embedders (the sparse BM42
# model, and the dense embedder when EMBEDDING_PROVIDER=fastembed) run on ONNX,
# which otherwise grabs every core — saturating CPU mid-ingest so the uvicorn
# event loop can't answer /health and Docker restarts the container.
#   0  = auto: leave 2 cores free for the event loop (recommended)
#   N  = pin the ONNX thread pool to exactly N threads
# Auto reads the available core count (sched_getaffinity); it honors cpuset
# pinning but NOT a CFS quota, so if you cap the container with `cpus:` you must
# set EMBEDDING_THREADS explicitly.
EMBEDDING_THREADS=0
# Backstop for OpenMP/BLAS kernels inside onnxruntime (read at native load time,
# so it must be an env var, not set in code). Keep at or below EMBEDDING_THREADS.
OMP_NUM_THREADS=4

# --------------------------------------------------------------------------
# Qdrant
# --------------------------------------------------------------------------

QDRANT_URI=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_INDEX=ingestion_files

# --------------------------------------------------------------------------
# S3 (boto3-standard names)
# --------------------------------------------------------------------------

S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION=us-east-1
# Comma-separated allow-list of S3 buckets the service may fetch from.
# Empty = no enforcement (the service logs a warning at startup). Set this
# in production to whatever bucket(s) Open WebUI's file Storage uses.
S3_ALLOWED_BUCKETS=
