# --------------------------------------------------------------------------
# Ingestion Service — environment template
#
# Copy to .env and fill in. Generate API_KEY with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# --------------------------------------------------------------------------

# Auth
API_KEY=CHANGE_ME_NOW

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=false

# --------------------------------------------------------------------------
# Extraction
# --------------------------------------------------------------------------

# tika | pypdf | docling | unstructured | kreuzberg
# tika / kreuzberg run as external HTTP sidecars (containers in the parent stack).
# pypdf is in-process and PDF-only.
# docling / unstructured require optional deps not bundled by default.
EXTRACTION_ENGINE=tika
TIKA_URL=http://tika:9998
KREUZBERG_URL=http://kreuzberg:8000

# --------------------------------------------------------------------------
# Chunking
# --------------------------------------------------------------------------

# token | markdown | word | sentence | passage
# - token (default): chunk size is measured in the embedding model's actual
#   HuggingFace tokens via a recursive char splitter. Keeps chunks under the
#   model's context window without hand-tuning word counts. Uses TOKENIZER_MODEL
#   if set, otherwise falls back to EMBEDDING_MODEL.
# - markdown: structure-aware mode. Splits on Markdown headings (#, ##, ###)
#   first, then token-packs each section when it exceeds CHUNK_SIZE. Each
#   chunk carries its heading hierarchy in meta.headers (e.g.
#   ["Privacy", "Foundational Principles"]). Most useful when the converter
#   emits Markdown (Docling natively; Kreuzberg after table-rendering is added).
#   Plain text content degrades gracefully to token-mode behaviour.
# - word / sentence / passage: delegates to Haystack's DocumentSplitter and
#   counts chunk size in those units (approximate vs. the model's tokenizer).
CHUNK_SPLIT_BY=token
CHUNK_SIZE=400
CHUNK_OVERLAP=80
# Optional. Used in token and markdown modes; defaults to EMBEDDING_MODEL when empty.
TOKENIZER_MODEL=

# --------------------------------------------------------------------------
# Dense embedder (required)
# --------------------------------------------------------------------------

# openai-compat | fastembed | tei
EMBEDDING_PROVIDER=openai-compat
EMBEDDING_API_BASE_URL=https://embed.itkdev.dk/v1
EMBEDDING_API_KEY=CHANGE_ME_NOW
EMBEDDING_MODEL=intfloat/multilingual-e5-large
EMBEDDING_DIM=1024
# Per the model card. e5: "passage: " on docs, "query: " on queries; bge-m3 takes none.
EMBEDDING_PREFIX_DOC="passage: "
EMBEDDING_PREFIX_QUERY="query: "

# --------------------------------------------------------------------------
# Sparse embedder (optional)
# --------------------------------------------------------------------------

ENABLE_SPARSE_EMBEDDINGS=false
# fastembed | none
SPARSE_EMBEDDING_PROVIDER=fastembed
SPARSE_EMBEDDING_MODEL=Qdrant/bm42-all-minilm-l6-v2-attentions

# --------------------------------------------------------------------------
# Qdrant
# --------------------------------------------------------------------------

QDRANT_URI=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_INDEX=ingestion_files

# --------------------------------------------------------------------------
# S3 (boto3-standard names)
# --------------------------------------------------------------------------

S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION=us-east-1
