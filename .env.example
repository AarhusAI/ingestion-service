# --------------------------------------------------------------------------
# Ingestion Service — environment template
#
# Copy to .env and fill in. Generate API_KEY with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# --------------------------------------------------------------------------

# Auth
API_KEY=CHANGE_ME_NOW

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=false
REQUEST_TIMEOUT=300

# --------------------------------------------------------------------------
# Extraction
# --------------------------------------------------------------------------

# tika | pypdf | docling | unstructured
# (docling/unstructured require optional deps not bundled by default)
EXTRACTION_ENGINE=tika
TIKA_URL=http://tika:9998

# --------------------------------------------------------------------------
# Chunking
# --------------------------------------------------------------------------

CHUNK_SIZE=440
CHUNK_OVERLAP=100
CHUNK_SPLIT_BY=word

# --------------------------------------------------------------------------
# Dense embedder (required)
# --------------------------------------------------------------------------

# openai-compat | fastembed | tei
EMBEDDING_PROVIDER=openai-compat
EMBEDDING_API_BASE_URL=https://embed.itkdev.dk/v1
EMBEDDING_API_KEY=CHANGE_ME_NOW
EMBEDDING_MODEL=intfloat/multilingual-e5-large
EMBEDDING_DIM=1024
# Per the model card. e5: "passage: " on docs, "query: " on queries; bge-m3 takes none.
EMBEDDING_PREFIX_DOC="passage: "
EMBEDDING_PREFIX_QUERY="query: "

# --------------------------------------------------------------------------
# Sparse embedder (optional)
# --------------------------------------------------------------------------

ENABLE_SPARSE_EMBEDDINGS=false
# fastembed | none
SPARSE_EMBEDDING_PROVIDER=fastembed
SPARSE_EMBEDDING_MODEL=Qdrant/bm42-all-minilm-l6-v2-attentions

# --------------------------------------------------------------------------
# Qdrant
# --------------------------------------------------------------------------

QDRANT_URI=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_INDEX=ingestion_files

# --------------------------------------------------------------------------
# S3 (boto3-standard names)
# --------------------------------------------------------------------------

S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION=us-east-1
